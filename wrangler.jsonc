{
  "name": "techo-vecino",
  "compatibility_date": "2026-10-24",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist"
  }

  // Variables de entorno: definir al desplegar, SIN valores en este archivo.
  //   Público (no sensible):  "vars": { "PUBLIC_SUPABASE_URL": "...", "PUBLIC_SUPABASE_ANON_KEY": "..." }
  //   Secretos (solo servidor): wrangler secret put SUPABASE_SERVICE_ROLE_KEY / ADMIN_EMAIL / WHATSAPP_NUMBER
  //   Local: archivo .dev.vars (gitignored)
  //
  // Sesiones: @astrojs/cloudflare 12 habilita sesiones con un binding KV "SESSION".
  //   No usamos sesiones. Si al desplegar wrangler muestra "Invalid binding SESSION",
  //   crea el namespace con: wrangler kv namespace create SESSION
  //   y añade: "kv_namespaces": [{ "binding": "SESSION", "id": "<namespace_id>" }]
}
